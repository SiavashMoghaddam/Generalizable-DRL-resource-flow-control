					<ShowLabel>true</ShowLabel>
					<Action><![CDATA[stockForm += (areaZone*assFormC.quantity2/assFormC.quantity1);
int StorageCapForm = roundToInt(storageCap*areaZone*numZone*(formC_m2 + formBF_m2));

wasteCapForm += Math.max(0, stockForm - StorageCapForm);

stockForm = Math.min(StorageCapForm, stockForm);
funcAssignMatForm();]]></Action>
