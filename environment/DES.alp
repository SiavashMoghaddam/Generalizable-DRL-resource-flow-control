				<Name><![CDATA[IobsRealOrderForm]]></Name>
				<Type><![CDATA[int]]></Type>
			</ObservationField>
			<ObservationCode><![CDATA[obsCapRebar = root.capRebar;
obsCapForm = root.capForm;
obsCapConc = root.capConc;
obsWaitingForMatRebar = root.queRebarCUnit.size()+root.assRebarC.queueSize(1)
						+ root.queRebarBFUnit.size()+root.assRebarBF.queueSize(1);
obsWaitingForMatForm = root.queFormCUnit.size()+root.assFormC.queueSize(1)
						+ root.queFormBFUnit.size()+root.assFormBF.queueSize(1);
obsWaitingForMatConc = root.queConcCUnit.size()+root.assConcC.queueSize(1)
						+ root.queConcBFUnit.size()+root.assConcBF.queueSize(1);
obsWaitingForServRebar = root.serviceRebarC.queueSize()+root.serviceRebarC.delaySize()
					+ root.serviceRebarBF.queueSize()+root.serviceRebarBF.delaySize();
obsWaitingForServForm = root.serviceFormC.queueSize()+root.serviceFormC.delaySize()
					+ root.serviceFormBF.queueSize()+root.serviceFormBF.delaySize();
obsWaitingForServConc = root.serviceConcC.queueSize()+root.serviceConcC.delaySize()
					+ root.serviceConcBF.queueSize()+root.serviceConcBF.delaySize();
obsStockRebar = root.stockRebar;
obsStockForm = root.stockForm;
obsStockConc = root.stockConc;
obsAssedRebar = (int) (root.assRebarC.out.count() + root.assRebarBF.out.count());
obsAssedForm = (int) (root.assFormC.out.count()*10 + root.assFormBF.out.count()*10);
obsAssedConc = (int) (root.assConcC.out.count()*10 + root.assConcBF.out.count()*10);
obsDoneRebar = root.doneRebarC + root.doneRebarBF;
obsDoneForm = root.doneFormC + root.doneFormBF;
obsDoneConc = root.doneConcC + root.doneConcBF;
obsRebarOnWay = root.rebarOnWay;
obsFormOnWay = root.formOnWay;
obsWasteRebar = root.wasteRebar;
obsWasteForm = root.wasteForm;
obsCashInHand = root.cashInHand;
obsProgress = root.progress;
IobsRealOrderRebar = root.RealOrderRebar;
IobsRealOrderForm = root.RealOrderForm;]]></ObservationCode>
			<StopCondition><![CDATA[root.isDone]]></StopCondition>
			<ActionField>
				<Name><![CDATA[actCapRebar]]></Name>
				<Type><![CDATA[int]]></Type>
			</ActionField>
			<ActionField>
				<Name><![CDATA[actCapForm]]></Name>
				<Type><![CDATA[int]]></Type>
			</ActionField>
			<ActionField>
				<Name><![CDATA[actCapConc]]></Name>
				<Type><![CDATA[int]]></Type>
			</ActionField>
			<ActionField>
				<Name><![CDATA[actMatRebar]]></Name>
				<Type><![CDATA[int]]></Type>
			</ActionField>
			<ActionField>
				<Name><![CDATA[actMatForm]]></Name>
				<Type><![CDATA[int]]></Type>
			</ActionField>
			<ActionField>
				<Name><![CDATA[actMatConc]]></Name>
				<Type><![CDATA[int]]></Type>
			</ActionField>
			<ActionCode><![CDATA[root.set_capRebar(actCapRebar);
root.set_capForm(actCapForm);
root.set_capConc(actCapConc);

int remainOrderRebar = root.maxOrderRebar - root.totalOrderedRebar + root.wasteCapRebar;
int orderAmountRebar = Math.max(0, Math.min(actMatRebar*5000, remainOrderRebar));
root.RealOrderRebar = orderAmountRebar;
if(orderAmountRebar > 0){
	double leadRebar = root.triangular(3,7);
	root.create_eventOrderRebar(leadRebar, root.DAY, orderAmountRebar);
	root.rebarOnWay += orderAmountRebar;
	root.cashInHand -= orderAmountRebar*0.4;
	root.totalOrderedRebar += orderAmountRebar;}
root.totalRequestedRebar += actMatRebar*5000;
root.wasteRebar = Math.max(0, root.totalRequestedRebar - root.maxOrderRebar);

int remainOrderForm = root.maxOrderForm - root.totalOrderedForm + root.wasteCapForm;
int orderAmountForm = Math.max(0, Math.min(actMatForm*50, remainOrderForm));
root.RealOrderForm = orderAmountForm;
if(orderAmountForm > 0){
	double leadForm = root.triangular(1,3);
	root.create_eventOrderForm(leadForm, root.DAY, orderAmountForm);
	root.formOnWay += orderAmountForm;
	root.cashInHand -= orderAmountForm*50;
	root.totalOrderedForm += orderAmountForm;}
root.totalRequestedForm += actMatForm*50;
root.wasteForm = Math.max(0, root.totalRequestedForm - root.maxOrderForm);

double leadConc = 1.0;
root.create_eventOrderConc(leadConc, root.DAY, actMatConc);

root.cashInHand -= (actCapRebar + actCapForm +actCapConc)*400;
root.cashInHand -= (actMatConc*200);

root.funcAssignMatRebar();
root.funcAssignMatForm();
root.funcAssignMatConc();]]></ActionCode>
