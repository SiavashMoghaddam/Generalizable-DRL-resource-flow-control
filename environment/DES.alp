			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1746196883676</Id>
					<Name><![CDATA[funcProgress]]></Name>
					<X>360</X><Y>1200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double totalUnits = numFloor*numZone*areaZone;

double progRebarC = doneRebarC/totalUnits;
double progFormC = doneFormC/totalUnits;
double progConcC = doneConcC/totalUnits;

double progRebarBF = doneRebarBF/totalUnits;
double progFormBF = doneFormBF/totalUnits;
double progConcBF = doneConcBF/totalUnits;
progress = 0.3*(progRebarC+progRebarBF) + 0.05*(progFormC+progFormBF) + 0.15*(progConcC+progConcBF);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1750589921122</Id>
					<Name><![CDATA[funcAssignMatRebar]]></Name>
					<X>360</X><Y>1230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// 1) Beam‐&‐floor rebar first
if(stockRebar > 0) {
  int queuedBF  = assRebarBF.queueSize(1);
  int unitsBF   = queRebarBFUnit.size();
  int totalBF   = queuedBF + unitsBF;
  if(totalBF > 0) {
    // compute how much rebar we need for beam/floor today:
    int reqBF = (totalBF * assRebarBF.quantity2 / assRebarBF.quantity1) - assRebarBF.queueSize(2);
    // decide how much to inject:
    int giveBF = Math.min(stockRebar, reqBF);
    matRebarBF.inject(giveBF);
    stockRebar -= giveBF;
  }
}

// 2) Then columns
if(stockRebar > 0) {
  int queuedC  = assRebarC.queueSize(1);
  int unitsC   = queRebarCUnit.size();
  int totalC   = queuedC + unitsC;
  if(totalC > 0) {
    int reqC = (totalC * assRebarC.quantity2 / assRebarC.quantity1) - assRebarC.queueSize(2);
    int giveC = Math.min(stockRebar, reqC);
    matRebarC.inject(giveC);
    stockRebar -= giveC;
  }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1750591713437</Id>
					<Name><![CDATA[funcAssignMatForm]]></Name>
					<X>360</X><Y>1260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// 1) Beam‐&‐floor Form first
if(stockForm > 0) {
  int queuedBF  = assFormBF.queueSize(1);
  int unitsBF   = queFormBFUnit.size();
  int totalBF   = queuedBF + unitsBF;
  if(totalBF > 0) {
    // compute how much Form we need for beam/floor today:
    int reqBF = (totalBF * assFormBF.quantity2 / assFormBF.quantity1) - assFormBF.queueSize(2);
    // decide how much to inject:
    int giveBF = Math.min(stockForm, reqBF);
    matFormBF.inject(giveBF);
    stockForm -= giveBF;
  }
}

// 2) Then columns
if(stockForm > 0) {
  int queuedC  = assFormC.queueSize(1);
  int unitsC   = queFormCUnit.size();
  int totalC   = queuedC + unitsC;
  if(totalC > 0) {
    int reqC = (totalC * assFormC.quantity2 / assFormC.quantity1) - assFormC.queueSize(2);
    int giveC = Math.min(stockForm, reqC);
    matFormC.inject(giveC);
    stockForm -= giveC;
  }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1750592068997</Id>
					<Name><![CDATA[funcAssignMatConc]]></Name>
					<X>360</X><Y>1290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// 1) Beam‐&‐floor Conc first
if(stockConc > 0) {
  int queuedBF  = assConcBF.queueSize(1);
  int unitsBF   = queConcBFUnit.size();
  int totalBF   = queuedBF + unitsBF;
  if(totalBF > 0) {
    // compute how much Conc we need for beam/floor today:
    int reqBF = totalBF * assConcBF.quantity2
                      / assConcBF.quantity1;

    reqBF -= assConcBF.queueSize(2);
    // decide how much to inject:
    int giveBF = Math.min(stockConc, reqBF);
    matConcBF.inject(giveBF);
    stockConc -= giveBF;
  }
}

// 2) Then columns
if(stockConc > 0) {
  int queuedC  = assConcC.queueSize(1);
  int unitsC   = queConcCUnit.size();
  int totalC   = queuedC + unitsC;
  if(totalC > 0) {
    int reqC = totalC * assConcC.quantity2
                    / assConcC.quantity1;
    reqC -= assConcC.queueSize(2);
    int giveC = Math.min(stockConc, reqC);
    matConcC.inject(giveC);
    stockConc -= giveC;
  }
}]]></Body>
				</Function>
			</Functions>
