					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[int totalUnits = numFloor*numZone*areaZone;

if (sink.count()%(numZone*areaZone) == 0 && sink.count() < totalUnits){
	double lagPay = triangular(3,5);
	create_eventPayment(lagPay, DAY, payPerUnit*numZone*areaZone);
	}

if (sink.count() == totalUnits) {
    cashInHand += (payPerUnit*numZone*areaZone);
    isDone = true;
}]]></Code>
							</Value>
