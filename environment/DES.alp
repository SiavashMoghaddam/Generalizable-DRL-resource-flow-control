		<ActiveObjectClass>
			<Id>1746194765224</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[batch.set_batchSize(areaZone);
batch1.set_batchSize(areaZone);
batch2.set_batchSize(areaZone);
batch3.set_batchSize(areaZone);
batch4.set_batchSize(areaZone);
batch5.set_batchSize(areaZone);

WorkUnit.inject(areaZone*numZone);
totalInjected += (areaZone*numZone);
cashInHand = cashStart;

set_maxOrderRebar((rebarC_kg + rebarBF_kg)* numFloor*numZone*areaZone);
set_maxOrderForm((int)Math.ceil((formC_m2 + formBF_m2)* 2*numZone*areaZone));


funcAssignMatRebar();
funcAssignMatForm();
funcAssignMatConc();]]></StartupCode>
